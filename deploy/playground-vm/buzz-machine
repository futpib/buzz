#!/usr/bin/env bash
set -euo pipefail
set -a
# shellcheck source=/dev/null
source /opt/buzz/config/admin.env
set +a
if [[ -n "${BUZZ_MACHINE_USER:-}" ]]; then
  [[ "$BUZZ_MACHINE_USER" =~ ^[a-zA-Z0-9_-]{1,40}$ ]] || exit 2
  BUZZ_PRIVATE_KEY="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["nsec"])' "/opt/buzz/config/users/$BUZZ_MACHINE_USER.json")"
  export BUZZ_PRIVATE_KEY
fi
exec /opt/buzz/bin/buzz "$@"
