(slopd_mcp) {
	@slopd_mcp {
		path /mcp /mcp/*
		path /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
		path /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/*
		path /oauth/register /oauth/authorize /oauth/token
	}
	handle @slopd_mcp {
		reverse_proxy 10.77.77.2:8780 {
			flush_interval -1
		}
	}
}

{$MCP_PUBLIC_HOST} {
	import slopd_mcp

	handle {
		respond 404
	}
}

{$VPS_PUBLIC_IP} {
	tls {
		issuer acme {
			profile shortlived
			disable_tlsalpn_challenge
		}
	}
	encode zstd gzip

	handle /pair {
		reverse_proxy 10.77.77.2:5000
	}

	import slopd_mcp

	handle {
		reverse_proxy 10.77.77.2:3000
	}
}
