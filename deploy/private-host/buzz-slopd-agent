#!/usr/bin/env bash
set -euo pipefail

identity_format="${BUZZ_SLOPD_AGENT_IDENTITY_FORMAT:-text}"
identity_file="${BUZZ_SLOPD_AGENT_IDENTITY_FILE:-${HOME}/.config/buzz-slopd-agent/identity.txt}"

if [[ ! -r "${identity_file}" ]]; then
  echo "buzz-slopd-agent: identity file is missing or unreadable: ${identity_file}" >&2
  exit 1
fi

case "${identity_format}" in
  text)
    public_key="$(
      sed -n 's/^Public key:[[:space:]]*//p' "${identity_file}" |
        tr -d '\r' |
        tail -n 1
    )"
    private_key="$(
      sed -n 's/^Secret key:[[:space:]]*//p' "${identity_file}" |
        tr -d '\r' |
        tail -n 1
    )"
    ;;
  pem)
    private_key="$(
      openssl pkey -in "${identity_file}" -text -noout 2>/dev/null |
        awk '
          /^priv:/ { in_private = 1; next }
          /^pub:/ { in_private = 0 }
          in_private {
            gsub(/[[:space:]:]/, "")
            printf "%s", $0
          }
        '
    )"
    public_key="$(
      openssl pkey -in "${identity_file}" -pubout -outform DER 2>/dev/null |
        tail -c 65 |
        xxd -p -c 65 |
        sed 's/^04//' |
        cut -c 1-64
    )"
    ;;
  *)
    echo "buzz-slopd-agent: unsupported identity format: ${identity_format}" >&2
    exit 1
    ;;
esac

if [[ ! "${public_key}" =~ ^[0-9a-fA-F]{64}$ ]]; then
  echo "buzz-slopd-agent: identity file has no valid public key" >&2
  exit 1
fi

if [[ ! "${private_key}" =~ ^[0-9a-fA-F]{64}$ ]]; then
  echo "buzz-slopd-agent: identity file has no valid private key" >&2
  exit 1
fi

case "${1:-}" in
  --public-key)
    printf '%s\n' "${public_key}"
    exit 0
    ;;
  --cli)
    shift
    export BUZZ_PRIVATE_KEY="${private_key}"
    exec "${BUZZ_CLI_BIN:?BUZZ_CLI_BIN is required}" "$@"
    ;;
esac

: "${BUZZ_ACP_BIN:?BUZZ_ACP_BIN is required}"
: "${BUZZ_RELAY_WS_URL:?BUZZ_RELAY_WS_URL is required}"
: "${BUZZ_AGENT_OWNER:?BUZZ_AGENT_OWNER is required}"
: "${SLOPD_ACP_BIN:?SLOPD_ACP_BIN is required}"
: "${BUZZ_AGENT_ACCOUNT:?BUZZ_AGENT_ACCOUNT is required}"
: "${BUZZ_AGENT_BACKEND:?BUZZ_AGENT_BACKEND is required}"
: "${BUZZ_AGENT_SESSION_TITLE:?BUZZ_AGENT_SESSION_TITLE is required}"

slopd_socket="${SLOPD_SOCKET:-${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}/slopd-buzz-agent/slopd.sock}"

export BUZZ_PRIVATE_KEY="${private_key}"
exec "${BUZZ_ACP_BIN}" \
  --relay-url "${BUZZ_RELAY_WS_URL}" \
  --agent-owner "${BUZZ_AGENT_OWNER}" \
  --agent-command "${SLOPD_ACP_BIN}" \
  "--agent-args=--socket,${slopd_socket},--account,${BUZZ_AGENT_ACCOUNT},--backend,${BUZZ_AGENT_BACKEND},--forward-buzz-env" \
  --respond-to owner-only \
  --agents 1 \
  --session-title "${BUZZ_AGENT_SESSION_TITLE}" \
  "$@"
