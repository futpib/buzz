# Shared, non-secret settings for the always-on Buzz/slopd bridges.
# Install as ~/.config/buzz-slopd-agent/bridge.env and update the placeholders.
BUZZ_RELAY_URL=https://CHANGE_ME_PUBLIC_IP
BUZZ_RELAY_WS_URL=wss://CHANGE_ME_PUBLIC_IP
BUZZ_AGENT_OWNER=CHANGE_ME_OWNER_HEX_PUBLIC_KEY
BUZZ_ACP_BIN=/home/CHANGE_ME_USER/.local/libexec/buzz/CHANGE_ME_REVISION/buzz-acp
BUZZ_CLI_BIN=/home/CHANGE_ME_USER/.local/bin/buzz
SLOPD_ACP_BIN=/home/CHANGE_ME_USER/.local/libexec/slopd-buzz/CHANGE_ME_REVISION/slopd-acp
