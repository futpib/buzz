[Unit]
Description=Always-on Buzz Codex %i preset
Wants=network-online.target
After=network-online.target slopd-buzz-agent.service
Requires=slopd-buzz-agent.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h
Environment=RUST_LOG=buzz_acp=info,info
EnvironmentFile=%h/.config/buzz-slopd-agent/bridge.env
EnvironmentFile=%h/.config/buzz-machine/public.env
EnvironmentFile=%h/.config/buzz-slopd-agent/auth-codex-%i.env
EnvironmentFile=-%h/.config/buzz-coordinator-bot/public.env
Environment=BUZZ_SLOPD_AGENT_IDENTITY_FORMAT=pem
Environment=BUZZ_SLOPD_AGENT_IDENTITY_FILE=%h/.config/buzz-slopd-codex-%i-agent/identity.pem
Environment=BUZZ_AGENT_ACCOUNT=codex-%i
Environment=BUZZ_AGENT_BACKEND=codex
Environment=BUZZ_AGENT_SESSION_TITLE=slopd-codex-%i
ExecStart=%h/.local/libexec/buzz-slopd-agent
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=75

[Install]
WantedBy=default.target
