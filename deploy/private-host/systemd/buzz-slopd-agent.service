[Unit]
Description=Always-on Buzz ACP bridge to the isolated slopd Codex account
Documentation=https://github.com/block/buzz
Wants=network-online.target
After=network-online.target slopd-buzz-agent.service
Requires=slopd-buzz-agent.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h
Environment=RUST_LOG=buzz_acp=info,info
EnvironmentFile=%h/.config/buzz-slopd-agent/bridge.env
Environment=BUZZ_SLOPD_AGENT_IDENTITY_FORMAT=text
Environment=BUZZ_AGENT_ACCOUNT=codex
Environment=BUZZ_AGENT_BACKEND=codex
Environment="BUZZ_AGENT_SESSION_TITLE=slopd codex"
ExecStart=%h/.local/libexec/buzz-slopd-agent
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
