# Copy to ../compose/.env, generate every secret once, and keep that file
# private. The root .gitignore already excludes deploy/compose/.env.

COMPOSE_FILE=compose.yml:compose.private-host.yml
BUZZ_DATA_DIR=/home/CHANGE_ME_USER/buzz-data
BUZZ_IMAGE=ghcr.io/block/buzz@sha256:5e67a1f74ffb7907ef7f10196e643a675a73d172783359bbb519bbea994dc7ac

BUZZ_DOMAIN=CHANGE_ME_VPS_PUBLIC_IP
RELAY_URL=wss://CHANGE_ME_VPS_PUBLIC_IP
BUZZ_MEDIA_BASE_URL=https://CHANGE_ME_VPS_PUBLIC_IP/media
BUZZ_MEDIA_SERVER_DOMAIN=CHANGE_ME_VPS_PUBLIC_IP
BUZZ_CORS_ORIGINS=https://CHANGE_ME_VPS_PUBLIC_IP

BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_REQUIRE_MEDIA_GET_AUTH=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
BUZZ_PUSH_GATEWAY_DELIVERY_URL=
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBLIC_KEY_HEX
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_RELAY_PRIVATE_KEY_HEX
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX

POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
BUZZ_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
BUZZ_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
BUZZ_S3_BUCKET=buzz-media

BUZZ_HTTP_PORT=3000
